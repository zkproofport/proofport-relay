# Relay Service Environment
# These are set by docker-compose.yml in local dev.
# For standalone usage, copy and fill in values.

PORT=4001
REDIS_URL=
API_URL=
INTERNAL_API_KEY=dev-internal-key
RELAY_PRIVATE_KEY=
NULLIFIER_REGISTRY_ADDRESS=
CHAIN_RPC_URL=https://sepolia.base.org
# Required. The relay's public origin, put in every deep link as the callback
# URL (no path or trailing slash; https unless RELAY_EDGE=local). Locally
# docker-compose.yml sets http://<LAN IP>:4001 so a phone can reach it.
RELAY_EXTERNAL_URL=
# Required. Bearer token for GET /api/v1/stats, at least 32 characters
# (openssl rand -hex 32). The relay refuses to start without it.
RELAY_STATS_TOKEN=
# What sits in front of the relay: cloud-run-domain | load-balancer | local (src/edge.ts)
RELAY_EDGE=local
# Optional. Play Console's response-encryption keys for
# POST /api/v1/play-integrity/decrypt: base64 AES-256 decryption key and
# base64 DER (SPKI) EC P-256 verification key. Either unset -> that endpoint
# answers 503 naming it; the rest of the relay is unaffected.
PLAY_INTEGRITY_DECRYPTION_KEY=
PLAY_INTEGRITY_VERIFICATION_KEY=
