# Relay Service Environment
# These are set by docker-compose.yml in local dev.
# For standalone usage, copy and fill in values.

PORT=4001
REDIS_URL=
API_URL=
INTERNAL_API_KEY=dev-internal-key
RELAY_PRIVATE_KEY=
NULLIFIER_REGISTRY_ADDRESS=
CHAIN_RPC_URL=https://sepolia.base.org
RELAY_EXTERNAL_URL=
# Required. Bearer token for GET /api/v1/stats, at least 32 characters
# (openssl rand -hex 32). The relay refuses to start without it.
RELAY_STATS_TOKEN=
