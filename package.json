    "ethers": "^6.16.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "proxy-addr": "^2.0.8",
    "socket.io": "^4.8.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/proxy-addr": "^2.0.3",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "d3-geo": "3.1.1",
    "i18n-iso-countries": "7.14.0",
    "playwright-core": "~1.63.0",
    "socket.io-client": "^4.8.4",
